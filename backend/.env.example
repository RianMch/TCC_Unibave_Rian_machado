# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).

DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco"

# Gere com: openssl rand -hex 64
JWT_SECRET=""

# Chave da OpenRouteService (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=""

ENDERECO_EMPRESA="Rua Exemplo, 123, Cidade, UF, Brasil"

# CORS: URL(s) do front, separadas por vírgula. Em dev, se omitida: http://localhost:5173
FRONTEND_URL="http://localhost:5173"

PORT=3000

# SÓ em produção atrás de proxy reverso (Render, Railway, Nginx...). Em dev deixe comentado:
# habilitado sem proxy, qualquer cliente forja X-Forwarded-For e burla o rate limit do login.
# TRUST_PROXY=1
